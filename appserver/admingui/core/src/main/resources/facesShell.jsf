<!--
    Prototype only (docs/試作計画.md P-3): the page frame (masthead and navigation tree) for a page that has moved to
    Facelets. AdminGuiViewHandler renders this view when such a page is opened directly; the frame then loads the
    page itself into the content area, in the same way as a click in the navigation tree.
-->
<!initPage
    setResourceBundle(key="i18n" bundle="org.glassfish.admingui.core.Strings");
/>
<!composition template="/templates/default.layout"
    guiTemplateOnLoad="if (window.location.pathname.indexOf('/facesShell.jsf') == -1) { admingui.ajax.loadPage({url: window.location.pathname + window.location.search}); }"
>
<!define name="content">
"<div id="facesShellContent"></div>
</define>
</composition>
